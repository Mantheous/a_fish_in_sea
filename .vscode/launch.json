{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: API Server",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": ["app.main:app", "--port", "8000", "--reload"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/server/api",
            "envFile": "${workspaceFolder}/server/.env",
            "python": "${workspaceFolder}/server/api/.venv/bin/python"
        },
        {
            "name": "Flutter",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "Flutter (remote server)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=SERVER_URL=http://100.111.106.47:8000"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Flutter & API Server",
            "configurations": ["Python: API Server", "Flutter"]
        }
    ]
}
